{
  // Cloudflare Pages configuration.
  //
  // IMPORTANT: once this file exists, Cloudflare Pages reads bindings from here
  // and IGNORES bindings configured in the dashboard. Everything the deployed
  // app needs must be declared below, or it will be missing in production.
  //
  // SvelteKit's adapter-cloudflare also reads this file during `npm run dev`
  // (via wrangler's getPlatformProxy), so local KV is wired up automatically.
  // Local KV is simulated on disk under .wrangler/ and starts empty.

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jlac-shaw-worship-team",
  "compatibility_date": "2026-09-16",
  "pages_build_output_dir": ".svelte-kit/cloudflare",

  // Namespace ids are created by `npm run setup:kv`. `id` is used by deployed
  // environments; `preview_id` is what `npm run dev` binds to locally.
  "kv_namespaces": [
    {
      "binding": "USERS_KV",
      "id": "4cb21c760b7a437291a63d757249fc0b",
      "preview_id": "2c1db1e8b74d4d96b8b4d63f00d8e91f"
    },
    {
      "binding": "SESSIONS_KV",
      "id": "d612dda4ad3e419c92090de7f7331597",
      "preview_id": "e274f53673b04b7d82d95a54e797971b"
    },
    {
      "binding": "LOG_KV",
      "id": "5fc4537a53be406784a667dc42a5a0aa",
      "preview_id": "5a64f7ef6ec2407fb5582734097749eb"
    }
  ]
}
